{
  "protocolVersion": 1,
  "rules": [
    "required",
    "type",
    "min",
    "max",
    "minLength",
    "maxLength",
    "length",
    "enum",
    "pattern",
    "format",
    "same",
    "different",
    "before",
    "after",
    "precision",
    "array",
    "object"
  ],
  "cases": [
    { "name": "required accepts zero", "field": "value", "values": { "value": 0 }, "rules": [{ "type": "required" }], "valid": true },
    { "name": "required rejects blank string", "field": "value", "values": { "value": "   " }, "rules": [{ "type": "required" }], "valid": false, "failedRule": "required" },
    { "name": "type accepts declared number", "field": "value", "values": { "value": 12.5 }, "rules": [{ "type": "type", "value": "number" }], "valid": true },
    { "name": "type rejects numeric string", "field": "value", "values": { "value": "12.5" }, "rules": [{ "type": "type", "value": "number" }], "valid": false, "failedRule": "type" },
    { "name": "min accepts boundary", "field": "value", "values": { "value": 10 }, "rules": [{ "type": "min", "value": 10 }], "valid": true },
    { "name": "min rejects smaller number", "field": "value", "values": { "value": 9 }, "rules": [{ "type": "min", "value": 10 }], "valid": false, "failedRule": "min" },
    { "name": "max accepts boundary", "field": "value", "values": { "value": 10 }, "rules": [{ "type": "max", "value": 10 }], "valid": true },
    { "name": "max rejects larger number", "field": "value", "values": { "value": 11 }, "rules": [{ "type": "max", "value": 10 }], "valid": false, "failedRule": "max" },
    { "name": "minLength counts unicode characters", "field": "value", "values": { "value": "你好" }, "rules": [{ "type": "minLength", "value": 2 }], "valid": true },
    { "name": "minLength rejects short array", "field": "value", "values": { "value": [1] }, "rules": [{ "type": "minLength", "value": 2 }], "valid": false, "failedRule": "minLength" },
    { "name": "maxLength accepts object size", "field": "value", "values": { "value": { "a": 1, "b": 2 } }, "rules": [{ "type": "maxLength", "value": 2 }], "valid": true },
    { "name": "maxLength rejects long string", "field": "value", "values": { "value": "abcd" }, "rules": [{ "type": "maxLength", "value": 3 }], "valid": false, "failedRule": "maxLength" },
    { "name": "length accepts exact array size", "field": "value", "values": { "value": [1, 2] }, "rules": [{ "type": "length", "value": 2 }], "valid": true },
    { "name": "length rejects different string size", "field": "value", "values": { "value": "abc" }, "rules": [{ "type": "length", "value": 2 }], "valid": false, "failedRule": "length" },
    { "name": "enum uses strict scalar equality", "field": "value", "values": { "value": 1 }, "rules": [{ "type": "enum", "value": [1, 2] }], "valid": true },
    { "name": "enum rejects scalar with different type", "field": "value", "values": { "value": "1" }, "rules": [{ "type": "enum", "value": [1, 2] }], "valid": false, "failedRule": "enum" },
    { "name": "pattern accepts matching unicode text", "field": "value", "values": { "value": "姓名" }, "rules": [{ "type": "pattern", "value": "^[\\p{L}]+$" }], "valid": true },
    { "name": "pattern rejects non matching text", "field": "value", "values": { "value": "ABC1" }, "rules": [{ "type": "pattern", "value": "^[A-Z]+$" }], "valid": false, "failedRule": "pattern" },
    { "name": "format accepts email", "field": "value", "values": { "value": "user@example.com" }, "rules": [{ "type": "format", "value": "email" }], "valid": true },
    { "name": "format rejects malformed email", "field": "value", "values": { "value": "user@" }, "rules": [{ "type": "format", "value": "email" }], "valid": false, "failedRule": "format" },
    { "name": "same accepts identical value and type", "field": "confirmation", "values": { "password": "123", "confirmation": "123" }, "rules": [{ "type": "same", "value": "password" }], "valid": true },
    { "name": "same rejects different type", "field": "confirmation", "values": { "password": 123, "confirmation": "123" }, "rules": [{ "type": "same", "value": "password" }], "valid": false, "failedRule": "same" },
    { "name": "different accepts another value", "field": "newValue", "values": { "oldValue": "a", "newValue": "b" }, "rules": [{ "type": "different", "value": "oldValue" }], "valid": true },
    { "name": "different rejects identical value", "field": "newValue", "values": { "oldValue": "a", "newValue": "a" }, "rules": [{ "type": "different", "value": "oldValue" }], "valid": false, "failedRule": "different" },
    { "name": "before accepts earlier ISO date", "field": "start", "values": { "start": "2026-09-01", "end": "2026-09-02" }, "rules": [{ "type": "before", "value": "end" }], "valid": true },
    { "name": "before rejects equal ISO date", "field": "start", "values": { "start": "2026-09-02", "end": "2026-09-02" }, "rules": [{ "type": "before", "value": "end" }], "valid": false, "failedRule": "before" },
    { "name": "after accepts later ISO datetime", "field": "end", "values": { "start": "2026-09-01T10:00:00Z", "end": "2026-09-01T11:00:00Z" }, "rules": [{ "type": "after", "value": "start" }], "valid": true },
    { "name": "after rejects invalid date", "field": "end", "values": { "start": "2026-09-01", "end": "not-a-date" }, "rules": [{ "type": "after", "value": "start" }], "valid": false, "failedRule": "after" },
    { "name": "precision accepts trailing decimal places", "field": "value", "values": { "value": "12.30" }, "rules": [{ "type": "precision", "value": 2 }], "valid": true },
    { "name": "precision rejects excessive decimal places", "field": "value", "values": { "value": 12.345 }, "rules": [{ "type": "precision", "value": 2 }], "valid": false, "failedRule": "precision" },
    { "name": "array accepts JSON array", "field": "value", "values": { "value": [1, 2] }, "rules": [{ "type": "array" }], "valid": true },
    { "name": "array rejects object", "field": "value", "values": { "value": { "a": 1 } }, "rules": [{ "type": "array" }], "valid": false, "failedRule": "array" },
    { "name": "object accepts JSON object", "field": "value", "values": { "value": { "a": 1 } }, "rules": [{ "type": "object" }], "valid": true },
    { "name": "object rejects array", "field": "value", "values": { "value": [1] }, "rules": [{ "type": "object" }], "valid": false, "failedRule": "object" },
    { "name": "optional empty value skips non required rules", "field": "value", "values": { "value": "" }, "rules": [{ "type": "format", "value": "email" }, { "type": "minLength", "value": 3 }], "valid": true },
    { "name": "first failure keeps custom message", "field": "value", "values": { "value": "x" }, "rules": [{ "type": "minLength", "value": 2, "message": "至少两个字符" }, { "type": "pattern", "value": "^[0-9]+$" }], "valid": false, "failedRule": "minLength", "message": "至少两个字符" }
  ]
}