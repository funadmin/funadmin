{
  "protocolVersion": 2,
  "rules": [
    "required", "type", "min", "max", "minLength", "maxLength", "length", "enum", "pattern", "format",
    "same", "different", "before", "after", "precision", "file", "array", "object", "items", "properties"
  ],
  "cases": [
    { "name": "required accepts zero", "field": "value", "values": { "value": 0 }, "rules": [{ "type": "required" }], "valid": true },
    { "name": "required rejects blank string", "field": "value", "values": { "value": "   " }, "rules": [{ "type": "required" }], "valid": false, "failedRules": ["required"] },
    { "name": "type accepts declared number", "field": "value", "values": { "value": 12.5 }, "rules": [{ "type": "type", "value": "number" }], "valid": true },
    { "name": "type rejects numeric string", "field": "value", "values": { "value": "12.5" }, "rules": [{ "type": "type", "value": "number" }], "valid": false, "failedRules": ["type"] },
    { "name": "min accepts boundary", "field": "value", "values": { "value": 10 }, "rules": [{ "type": "min", "value": 10 }], "valid": true },
    { "name": "min rejects smaller number", "field": "value", "values": { "value": 9 }, "rules": [{ "type": "min", "value": 10 }], "valid": false, "failedRules": ["min"] },
    { "name": "max accepts boundary", "field": "value", "values": { "value": 10 }, "rules": [{ "type": "max", "value": 10 }], "valid": true },
    { "name": "max rejects larger number", "field": "value", "values": { "value": 11 }, "rules": [{ "type": "max", "value": 10 }], "valid": false, "failedRules": ["max"] },
    { "name": "minLength counts unicode characters", "field": "value", "values": { "value": "你好" }, "rules": [{ "type": "minLength", "value": 2 }], "valid": true },
    { "name": "minLength rejects short array", "field": "value", "values": { "value": [1] }, "rules": [{ "type": "minLength", "value": 2 }], "valid": false, "failedRules": ["minLength"] },
    { "name": "maxLength accepts object size", "field": "value", "values": { "value": { "a": 1, "b": 2 } }, "rules": [{ "type": "maxLength", "value": 2 }], "valid": true },
    { "name": "maxLength rejects long string", "field": "value", "values": { "value": "abcd" }, "rules": [{ "type": "maxLength", "value": 3 }], "valid": false, "failedRules": ["maxLength"] },
    { "name": "length accepts exact array size", "field": "value", "values": { "value": [1, 2] }, "rules": [{ "type": "length", "value": 2 }], "valid": true },
    { "name": "length rejects different string size", "field": "value", "values": { "value": "abc" }, "rules": [{ "type": "length", "value": 2 }], "valid": false, "failedRules": ["length"] },
    { "name": "enum uses strict scalar equality", "field": "value", "values": { "value": 1 }, "rules": [{ "type": "enum", "value": [1, 2] }], "valid": true },
    { "name": "enum rejects scalar with different type", "field": "value", "values": { "value": "1" }, "rules": [{ "type": "enum", "value": [1, 2] }], "valid": false, "failedRules": ["enum"] },
    { "name": "pattern accepts compatible unicode properties", "field": "value", "values": { "value": "姓名" }, "rules": [{ "type": "pattern", "value": "^[\\p{L}]+$" }], "valid": true },
    { "name": "pattern rejects non matching text", "field": "value", "values": { "value": "ABC1" }, "rules": [{ "type": "pattern", "value": "^[A-Z]+$" }], "valid": false, "failedRules": ["pattern"] },
    { "name": "format accepts email", "field": "value", "values": { "value": "user@example.com" }, "rules": [{ "type": "format", "value": "email" }], "valid": true },
    { "name": "format rejects malformed email", "field": "value", "values": { "value": "user@" }, "rules": [{ "type": "format", "value": "email" }], "valid": false, "failedRules": ["format"] },
    { "name": "same accepts identical value and type", "field": "confirmation", "values": { "password": "123", "confirmation": "123" }, "rules": [{ "type": "same", "value": "password" }], "valid": true },
    { "name": "same rejects different type", "field": "confirmation", "values": { "password": 123, "confirmation": "123" }, "rules": [{ "type": "same", "value": "password" }], "valid": false, "failedRules": ["same"] },
    { "name": "different accepts another value", "field": "newValue", "values": { "oldValue": "a", "newValue": "b" }, "rules": [{ "type": "different", "value": "oldValue" }], "valid": true },
    { "name": "different rejects identical value", "field": "newValue", "values": { "oldValue": "a", "newValue": "a" }, "rules": [{ "type": "different", "value": "oldValue" }], "valid": false, "failedRules": ["different"] },
    { "name": "before accepts earlier ISO date", "field": "start", "values": { "start": "2026-09-01", "end": "2026-09-02" }, "rules": [{ "type": "before", "value": "end" }], "valid": true },
    { "name": "before rejects equal ISO date", "field": "start", "values": { "start": "2026-09-02", "end": "2026-09-02" }, "rules": [{ "type": "before", "value": "end" }], "valid": false, "failedRules": ["before"] },
    { "name": "after accepts later ISO datetime", "field": "end", "values": { "start": "2026-09-01T10:00:00Z", "end": "2026-09-01T11:00:00Z" }, "rules": [{ "type": "after", "value": "start" }], "valid": true },
    { "name": "after rejects invalid date", "field": "end", "values": { "start": "2026-09-01", "end": "not-a-date" }, "rules": [{ "type": "after", "value": "start" }], "valid": false, "failedRules": ["after"] },
    { "name": "precision accepts trailing decimal places", "field": "value", "values": { "value": "12.30" }, "rules": [{ "type": "precision", "value": 2 }], "valid": true },
    { "name": "precision rejects excessive decimal places", "field": "value", "values": { "value": 12.345 }, "rules": [{ "type": "precision", "value": 2 }], "valid": false, "failedRules": ["precision"] },
    { "name": "file accepts size mime and count boundaries", "field": "value", "values": { "value": [{ "name": "a.png", "size": 1024, "type": "image/png" }] }, "rules": [{ "type": "file", "value": { "size": 1024, "type": ["image/png"], "count": 1 } }], "valid": true },
    { "name": "file rejects oversized member", "field": "value", "values": { "value": [{ "name": "a.png", "size": 1025, "type": "image/png" }] }, "rules": [{ "type": "file", "value": { "size": 1024, "type": ["image/png"], "count": 1 } }], "valid": false, "failedRules": ["file"] },
    { "name": "file accepts extension wildcard", "field": "value", "values": { "value": { "name": "a.png", "size": 1, "type": "image/png" } }, "rules": [{ "type": "file", "value": { "type": ["image/*", ".jpg"] } }], "valid": true },
    { "name": "array accepts JSON array", "field": "value", "values": { "value": [1, 2] }, "rules": [{ "type": "array" }], "valid": true },
    { "name": "array rejects object", "field": "value", "values": { "value": { "a": 1 } }, "rules": [{ "type": "array" }], "valid": false, "failedRules": ["array"] },
    { "name": "object accepts JSON object", "field": "value", "values": { "value": { "a": 1 } }, "rules": [{ "type": "object" }], "valid": true },
    { "name": "object rejects array", "field": "value", "values": { "value": [1] }, "rules": [{ "type": "object" }], "valid": false, "failedRules": ["object"] },
    { "name": "items recursively validates every array member", "field": "value", "values": { "value": [1, "2"] }, "rules": [{ "type": "items", "value": [{ "type": "type", "value": "integer" }] }], "valid": false, "failedRules": ["items"], "path": "value.1" },
    { "name": "properties recursively validates nested object", "field": "profile", "values": { "profile": { "address": { "zip": "12" } } }, "rules": [{ "type": "properties", "value": { "address": [{ "type": "properties", "value": { "zip": [{ "type": "pattern", "value": "^[0-9]{5}$" }] } }] } }], "valid": false, "failedRules": ["properties"], "path": "profile.address.zip" },
    { "name": "when false skips rule", "field": "company", "values": { "kind": "person", "company": "" }, "rules": [{ "type": "required", "when": { "field": "kind", "op": "eq", "value": "business" } }], "valid": true },
    { "name": "when true executes rule", "field": "company", "values": { "kind": "business", "company": "" }, "rules": [{ "type": "required", "when": { "field": "kind", "op": "eq", "value": "business" } }], "valid": false, "failedRules": ["required"] },
    { "name": "bail false preserves same type multiple failures", "field": "value", "values": { "value": "ABC" }, "rules": [{ "type": "pattern", "value": "^[0-9]+$", "message": "仅数字", "bail": false }, { "type": "pattern", "value": "^.{5,}$", "message": "至少五位", "severity": "warning" }], "valid": false, "failedRules": ["pattern", "pattern"], "severities": ["error", "warning"] },
    { "name": "bail true stops following rules", "field": "value", "values": { "value": "x" }, "rules": [{ "type": "minLength", "value": 2, "message": "至少两个字符", "bail": true }, { "type": "pattern", "value": "^[0-9]+$" }], "valid": false, "failedRules": ["minLength"], "message": "至少两个字符" },
    { "name": "optional empty value skips non required rules", "field": "value", "values": { "value": "" }, "rules": [{ "type": "format", "value": "email" }, { "type": "minLength", "value": 3 }], "valid": true }
  ],
  "unsafePatterns": [
    "(a+)+$", "(a*)*$", "(a|aa)+$", "(?=a)a", "(a)\\1", "(?<=a)b", "[a-z&&[^aeiou]]", "\\Aadmin$", "(?i)admin", "a++", "[[:alpha:]]"
  ]
}
