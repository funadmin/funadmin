{
  "schema_version": 1,
  "name": "example",
  "title": "测试示例插件",
  "description": "仅供仓库测试使用，不位于生产 plugins 目录",
  "author": "FunAdmin",
  "version": "1.0.0",
  "requires": {
    "php": ">=8.1",
    "funadmin": ">=1.0.0",
    "plugins": {}
  },
  "entry": {
    "class": "plugins\\example\\Plugin"
  },
  "services": "config/services.php",
  "events": "config/events.php",
  "routes": "routes/plugin.php",
  "permissions": [],
  "menus": [],
  "admin_web": {
    "entry": "entry.js",
    "routes": [
      {
        "path": "/plugin/example/index",
        "name": "Plugin_example_Index",
        "component": "Index",
        "meta": {
          "title": "测试示例插件"
        }
      }
    ]
  },
  "resources": {
    "public": { "source": "resources/public", "target": "plugin-assets/example/public" },
    "admin": { "source": "resources/admin", "target": "plugin-assets/example" }
  },
  "migrations": { "path": "migrations" },
  "storage": { "path": "storage/example" },
  "purge": { "supported": false }
}
