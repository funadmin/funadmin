{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funadmin.dev/schema/plugin-manifest-v1.schema.json",
  "title": "FunAdmin Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "title", "version", "requires", "entry"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 250 },
    "description": { "type": "string" },
    "author": { "type": "string", "maxLength": 100 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugins"],
      "properties": {
        "php": { "type": "string", "minLength": 1 },
        "funadmin": { "type": "string", "minLength": 1 },
        "plugins": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9]*$" }, "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": { "class": { "type": "string", "pattern": "^plugins\\\\[a-z][a-z0-9]*\\\\Plugin$" } }
    },
    "services": { "$ref": "#/$defs/phpPath" },
    "events": { "$ref": "#/$defs/phpPath" },
    "routes": { "$ref": "#/$defs/phpPath" },
    "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } },
    "menus": { "type": "array", "items": { "$ref": "#/$defs/menu" } },
    "admin_web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "routes"],
      "properties": {
        "entry": { "$ref": "#/$defs/jsPath" },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/adminRoute" } }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": { "$ref": "#/$defs/resource" },
        "admin": { "$ref": "#/$defs/resource" }
      }
    },
    "migrations": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "$ref": "#/$defs/path" } } },
    "storage": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "$ref": "#/$defs/path" } } },
    "purge": { "type": "object", "additionalProperties": false, "required": ["supported"], "properties": { "supported": { "type": "boolean" } } }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$" },
    "phpPath": { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.php$" }] },
    "jsPath": { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.m?js$" }] },
    "resource": { "type": "object", "additionalProperties": false, "required": ["source", "target"], "properties": { "source": { "$ref": "#/$defs/path" }, "target": { "$ref": "#/$defs/path" } } },
    "permission": { "type": "object", "additionalProperties": false, "required": ["code", "name"], "properties": { "code": { "type": "string", "pattern": "^[a-z][a-z0-9]*:[a-z][a-z0-9:-]*$" }, "name": { "type": "string", "minLength": 1 } } },
    "menu": { "type": "object", "additionalProperties": false, "required": ["name", "path"], "properties": { "name": { "type": "string", "minLength": 1 }, "path": { "type": "string", "pattern": "^/plugin/[a-z][a-z0-9]*/[A-Za-z0-9/_-]+$" }, "permission": { "type": "string" } } },
    "adminRoute": { "type": "object", "additionalProperties": false, "required": ["path", "name", "component"], "properties": { "path": { "type": "string", "pattern": "^/plugin/[a-z][a-z0-9]*/[A-Za-z0-9/_-]+$" }, "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }, "component": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_/-]*$" }, "meta": { "type": "object", "additionalProperties": false, "properties": { "title": { "type": "string" }, "icon": { "type": "string" }, "permission": { "type": "string" } } } } }
  }
}
