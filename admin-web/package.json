{
  "name": "admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Neutral Vue admin console for the Laravel admin backend",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "gen:crud": "node scripts/crud-gen.mjs",
    "gen:icons": "node scripts/generate-ep-icons.mjs",
    "scan:i18n": "node scripts/scan-i18n.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@iconify/vue": "^5.0.0",
    "@vueuse/core": "^14.2.1",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.15.2",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "element-plus": "^2.8.4",
    "lodash-es": "^4.17.21",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.13.0",
    "sortablejs": "^1.15.7",
    "vue": "3.5.32",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@iconify-json/ep": "^1.2.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.7.4",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.9.16",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^25.0.1",
    "sass": "^1.79.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.9",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  }
}
