/vendor/
/runtime/
/.env
/.phpunit.cache/
/public/index.html
/public/assets/
/public/plugin-assets/
/public/favicon.svg
/plugins/*
!/plugins/cms/
!/plugins/document/
!/plugins/oss/
!/plugins/qa/
/plugins/*/vendor/
/plugins/*/storage/*
!/plugins/*/storage/.gitkeep
/plugins/*/.env
/plugins/*/.DS_Store

# 插件安装副本与代码生成器产物不入库：插件只提交 plugins/<code>/ 源码，
# 安装发布到 app/<code>/、app/admin/plugins/<code>/ 的副本不提交；生成的业务模块不提交。
# app/ 顶层只保留核心目录。
# 新增核心目录时需在此加入 ! 例外。
/app/*
!/app/.gitignore
!/app/.htaccess
!/app/AppService.php
!/app/BaseController.php
!/app/ExceptionHandle.php
!/app/functions.php
!/app/admin/
!/app/api/
!/app/common/
!/app/install/
!/app/middleware/
!/app/process/
!/app/runtime/
!/app/view/
/app/admin/plugins/
/app/admin/business/
/database/business/
/tests/business/
# 插件相关测试不入库
/tests/Cms/
/tests/Document/
/tests/Oss/
/tests/Qa/
/tests/DocumentMigrationTest.php
/tests/DocumentPluginLayoutTest.php
/tests/ExamplePluginRuntimeTest.php
