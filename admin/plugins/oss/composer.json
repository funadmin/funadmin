{
  "name": "funadmin/plugin-oss",
  "description": "FunAdmin unified cloud storage plugin",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.5",
    "aliyuncs/oss-sdk-php": "^2.7.3",
    "qcloud/cos-sdk-v5": "^2.6.17",
    "qiniu/php-sdk": "^7.14.0"
  },
  "autoload": {
    "psr-4": {
      "app\\admin\\plugins\\oss\\": "app/admin/plugins/oss/"
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "scripts": {
    "post-install-cmd": [
      "@php tools/patch-vendor.php"
    ],
    "post-update-cmd": [
      "@php tools/patch-vendor.php"
    ]
  }
}
