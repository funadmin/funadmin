{
  "schema_version": 2,
  "code": "document",
  "name": "技术文档",
  "description": "FunAdmin 简约官方文档站，支持章节化内容、后台编辑与公开阅读",
  "version": "1.4.0",
  "requires": {
    "php": ">=8.5",
    "funadmin": ">=1.0.0",
    "plugins": {}
  },
  "entry": {
    "class": "plugins\\document\\Plugin",
    "file": "Plugin.php"
  },
  "migrations": {
    "path": "database/migrations"
  },
  "storage": {
    "path": "storage"
  },
  "purge": {
    "supported": false
  },
  "adminWeb": {
    "source": "web/src/admin/plugins/document",
    "components": {
      "Index": "Index.vue"
    },
    "minFrontendVersion": "1.0.0",
    "permissions": [
      {
        "code": "document:document:index",
        "name": "查看技术文档"
      },
      {
        "code": "document:document:create",
        "name": "新建技术文档"
      },
      {
        "code": "document:document:save-draft",
        "name": "编辑技术文档草稿"
      },
      {
        "code": "document:document:publish",
        "name": "发布技术文档"
      },
      {
        "code": "document:document:delete",
        "name": "删除技术文档"
      },
      {
        "code": "document:category:tree",
        "name": "查看文档目录"
      },
      {
        "code": "document:document:detail",
        "name": "查看技术文档详情"
      },
      {
        "code": "document:document:update-meta",
        "name": "修改技术文档信息"
      },
      {
        "code": "document:document:archive",
        "name": "归档技术文档"
      },
      {
        "code": "document:document:revisions",
        "name": "查看技术文档版本历史"
      },
      {
        "code": "document:document:revision",
        "name": "查看技术文档历史版本内容"
      },
      {
        "code": "document:document:restore",
        "name": "恢复技术文档历史版本"
      },
      {
        "code": "document:category:create",
        "name": "新建文档目录"
      },
      {
        "code": "document:category:update",
        "name": "修改文档目录"
      },
      {
        "code": "document:category:delete",
        "name": "删除文档目录"
      },
      {
        "code": "document:feedback:index",
        "name": "查看读者反馈"
      }
    ],
    "menu": [
      {
        "name": "技术文档",
        "path": "/plugins/document",
        "menulist": [
          {
            "name": "文档中心",
            "path": "/plugins/document/docs",
            "permission": "document:document:index"
          }
        ]
      }
    ],
    "routes": [
      {
        "path": "/plugins/document/docs",
        "name": "Plugin_document_Docs",
        "component": "Index",
        "meta": {
          "title": "技术文档",
          "permission": "document:document:index"
        }
      }
    ]
  }
}
