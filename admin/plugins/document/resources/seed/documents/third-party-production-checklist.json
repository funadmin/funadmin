{
    "slug": "third-party-production-checklist",
    "title": "第三方插件上线检查清单",
    "summary": "第三方插件安装前后的兼容性、权限、数据和升级检查。",
    "scope": "third_party",
    "type": "deployment",
    "category": "third-party-plugins",
    "appliesTo": "1.2",
    "visibility": "public",
    "content": {
        "type": "doc",
        "content": [
            {
                "type": "heading",
                "attrs": {
                    "level": 2
                },
                "content": [
                    {
                        "type": "text",
                        "text": "安装前"
                    }
                ]
            },
            {
                "type": "bulletList",
                "content": [
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "检查 plugin.json 的版本、PHP 要求、依赖和权限声明。"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "阅读 migrations 和 purge 配置，确认数据是否会创建或删除。"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "检查前端组件是否使用宿主已安装的 Vue、Element Plus 和 Tiptap 版本。"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "在测试库和测试域名安装，不要直接在生产库试运行。"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "type": "heading",
                "attrs": {
                    "level": 2
                },
                "content": [
                    {
                        "type": "text",
                        "text": "安全边界"
                    }
                ]
            },
            {
                "type": "bulletList",
                "content": [
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "插件控制器必须继承正确的后台或会员基类。"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "所有写接口必须有 CSRF 和权限检查。"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "插件前端路由必须以 /plugins/{code}/ 开头；旧 /plugin/{code}/ 仅作为兼容别名。"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "外部请求必须使用 HTTPS、超时和错误脱敏。"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "type": "heading",
                "attrs": {
                    "level": 2
                },
                "content": [
                    {
                        "type": "text",
                        "text": "上线后"
                    }
                ]
            },
            {
                "type": "orderedList",
                "attrs": {
                    "start": 1
                },
                "content": [
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "启用插件并确认菜单、接口和前端页面。"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "检查 activation snapshot 和 worker reload。"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "验证普通管理员权限边界。"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "执行一次备份和恢复演练。"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "listItem",
                        "content": [
                            {
                                "type": "paragraph",
                                "content": [
                                    {
                                        "type": "text",
                                        "text": "记录插件版本、数据库版本和回滚方式。"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "type": "callout",
                "attrs": {
                    "tone": "warning"
                },
                "content": [
                    {
                        "type": "paragraph",
                        "content": [
                            {
                                "type": "text",
                                "text": "第三方插件的“能安装”不代表“适合生产”。先审查权限、数据生命周期和升级路径，再开放给普通管理员。"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
