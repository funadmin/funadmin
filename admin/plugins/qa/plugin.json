{
  "schema_version": 2,
  "code": "qa",
  "name": "问答社区",
  "description": "会员提问、回答、审核与作者采纳，复用 CMS 投稿和站点权限",
  "version": "1.3.0",
  "requires": {
    "php": ">=8.5",
    "funadmin": ">=1.0.0",
    "plugins": {
      "cms": ">=1.6.0"
    }
  },
  "entry": {
    "class": "plugins\\qa\\Plugin",
    "file": "Plugin.php"
  },
  "migrations": {
    "path": "database/migrations"
  },
  "storage": {
    "path": "storage"
  },
  "purge": {
    "supported": false
  },
  "adminWeb": {
    "source": "web/src/admin/plugins/qa",
    "components": {
      "Moderation": "pages/Moderation.vue",
      "Questions": "pages/Questions.vue"
    },
    "minFrontendVersion": "1.0.0",
    "permissions": [
      {
        "code": "qa:moderation:index",
        "name": "查看问答投稿"
      },
      {
        "code": "qa:moderation:review",
        "name": "审核问答投稿"
      },
      {
        "code": "qa:questions:index",
        "name": "查看问题列表"
      },
      {
        "code": "qa:questions:detail",
        "name": "查看问题详情"
      },
      {
        "code": "qa:questions:attachment",
        "name": "下载问答附件"
      },
      {
        "code": "qa:questions:status",
        "name": "关闭/重新开放问题"
      },
      {
        "code": "qa:questions:pin",
        "name": "置顶/取消置顶问题"
      },
      {
        "code": "qa:questions:delete",
        "name": "删除问题"
      },
      {
        "code": "qa:questions:recycle",
        "name": "查看问题回收站"
      },
      {
        "code": "qa:questions:restore",
        "name": "恢复问题"
      },
      {
        "code": "qa:questions:destroy",
        "name": "彻底删除问题"
      },
      {
        "code": "qa:answers:visibility",
        "name": "隐藏/显示回答"
      },
      {
        "code": "qa:answers:delete",
        "name": "删除回答"
      },
      {
        "code": "qa:answers:recycle",
        "name": "查看回答回收站"
      },
      {
        "code": "qa:answers:restore",
        "name": "恢复回答"
      },
      {
        "code": "qa:answers:destroy",
        "name": "彻底删除回答"
      }
    ],
    "permissionGroups": {
      "moderation": "问答审核",
      "questions": "问题管理",
      "answers": "回答管理"
    },
    "menu": [
      {
        "name": "问答社区",
        "path": "/plugins/qa",
        "menulist": [
          {
            "name": "问答审核",
            "path": "/plugins/qa/moderation",
            "permission": "qa:moderation:index"
          },
          {
            "name": "问题管理",
            "path": "/plugins/qa/questions",
            "permission": "qa:questions:index"
          }
        ]
      }
    ],
    "routes": [
      {
        "path": "/plugins/qa/moderation",
        "name": "Plugin_qa_Moderation",
        "component": "Moderation",
        "meta": {
          "title": "问答审核",
          "permission": "qa:moderation:index"
        }
      },
      {
        "path": "/plugins/qa/questions",
        "name": "Plugin_qa_Questions",
        "component": "Questions",
        "meta": {
          "title": "问题管理",
          "permission": "qa:questions:index"
        }
      }
    ]
  }
}
