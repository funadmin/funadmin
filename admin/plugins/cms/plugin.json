{
  "schema_version": 2,
  "code": "cms",
  "name": "CMS 内容管理",
  "description": "多站点、多语言、服务端模板与自定义标签",
  "version": "1.3.3",
  "requires": {
    "php": ">=8.5",
    "funadmin": ">=1.0.0",
    "plugins": {}
  },
  "entry": {
    "class": "plugins\\cms\\Plugin",
    "file": "Plugin.php"
  },
  "resources": {
    "public": {
      "source": "public/plugin-assets/cms/public",
      "target": "plugin-assets/cms/public"
    }
  },
  "migrations": {
    "path": "database/migrations"
  },
  "storage": {
    "path": "storage"
  },
  "purge": {
    "supported": false
  },
  "adminWeb": {
    "source": "web/src/admin/plugins/cms",
    "components": {
      "Index": "pages/Index.vue",
      "Sites": "pages/Sites.vue",
      "Categories": "pages/Categories.vue",
      "Content": "pages/Content.vue",
      "Menus": "pages/Menus.vue",
      "Tags": "pages/Tags.vue",
      "Models": "pages/Models.vue",
      "Access": "pages/Access.vue",
      "Contributions": "pages/Contributions.vue",
      "Forms": "pages/Forms.vue"
    },
    "minFrontendVersion": "1.0.0",
    "permissions": [
      {
        "code": "cms:content:list",
        "name": "查看内容"
      },
      {
        "code": "cms:content:publish",
        "name": "发布内容"
      },
      {
        "code": "cms:content:offline",
        "name": "下架内容"
      },
      {
        "code": "cms:content:preview",
        "name": "预览内容"
      },
      {
        "code": "cms:category:list",
        "name": "查看栏目"
      },
      {
        "code": "cms:model:list",
        "name": "查看模型"
      },
      {
        "code": "cms:menu:list",
        "name": "查看导航"
      },
      {
        "code": "cms:tag:list",
        "name": "查看标签"
      },
      {
        "code": "cms:tag:publish",
        "name": "发布标签"
      },
      {
        "code": "cms:tag:preview",
        "name": "预览标签"
      },
      {
        "code": "cms:site:detail",
        "name": "查看设置"
      },
      {
        "code": "cms:site:edit",
        "name": "修改基本设置"
      },
      {
        "code": "cms:site:domain",
        "name": "管理域名"
      },
      {
        "code": "cms:site:locale",
        "name": "管理语言"
      },
      {
        "code": "cms:category:create",
        "name": "新建栏目"
      },
      {
        "code": "cms:category:edit",
        "name": "编辑栏目"
      },
      {
        "code": "cms:category:status",
        "name": "启用/停用栏目"
      },
      {
        "code": "cms:content:create",
        "name": "新建内容"
      },
      {
        "code": "cms:content:edit",
        "name": "编辑草稿"
      },
      {
        "code": "cms:menu:create",
        "name": "新建导航"
      },
      {
        "code": "cms:menu:edit",
        "name": "编辑导航"
      },
      {
        "code": "cms:menu:status",
        "name": "启用/停用导航"
      },
      {
        "code": "cms:menu:delete",
        "name": "删除导航组"
      },
      {
        "code": "cms:tag:create",
        "name": "新建标签"
      },
      {
        "code": "cms:tag:edit",
        "name": "编辑标签草稿"
      },
      {
        "code": "cms:model:status",
        "name": "本站模型启停"
      },
      {
        "code": "cms:model:template",
        "name": "设置本站模型模板"
      },
      {
        "code": "cms:access:list",
        "name": "查看成员/角色"
      },
      {
        "code": "cms:access:members",
        "name": "管理站点成员"
      },
      {
        "code": "cms:access:roles",
        "name": "管理站点角色"
      },
      {
        "code": "cms:submission:list",
        "name": "查看会员投稿"
      },
      {
        "code": "cms:submission:review",
        "name": "审核会员投稿"
      },
      {
        "code": "cms:sites:index",
        "name": "查看站点列表"
      },
      {
        "code": "cms:categories:index",
        "name": "查看栏目列表"
      },
      {
        "code": "cms:content:index",
        "name": "查看内容列表"
      },
      {
        "code": "cms:contributions:index",
        "name": "查看会员投稿列表"
      },
      {
        "code": "cms:menus:index",
        "name": "查看导航列表"
      },
      {
        "code": "cms:tags:index",
        "name": "查看标签列表"
      },
      {
        "code": "cms:models:index",
        "name": "查看模型列表"
      },
      {
        "code": "cms:access:index",
        "name": "查看站点成员与角色"
      },
      {
        "code": "cms:forms:index",
        "name": "查看表单列表"
      },
      {
        "code": "cms:form:list",
        "name": "查看表单"
      },
      {
        "code": "cms:form:manage",
        "name": "管理表单"
      },
      {
        "code": "cms:form:submissions",
        "name": "查看表单提交"
      },
      {
        "code": "cms:form:handle",
        "name": "跟进处理表单提交"
      },
      {
        "code": "cms:form:export",
        "name": "导出表单提交"
      },
      {
        "code": "cms:form:delete",
        "name": "删除表单提交"
      }
    ],
    "permissionGroups": {
      "site": "站点管理",
      "sites": "站点管理",
      "category": "栏目管理",
      "categories": "栏目管理",
      "content": "内容管理",
      "model": "内容模型",
      "models": "内容模型",
      "menu": "导航管理",
      "menus": "导航管理",
      "tag": "模板标签",
      "tags": "模板标签",
      "submission": "会员投稿",
      "contributions": "会员投稿",
      "access": "站点权限",
      "form": "表单",
      "forms": "表单"
    },
    "menu": [
      {
        "name": "CMS 内容管理",
        "path": "/plugins/cms",
        "menulist": [
          {
            "name": "站点管理",
            "path": "/plugins/cms/sites",
            "permission": "cms:sites:index"
          },
          {
            "name": "栏目管理",
            "path": "/plugins/cms/categories",
            "permission": "cms:categories:index"
          },
          {
            "name": "内容管理",
            "path": "/plugins/cms/content",
            "permission": "cms:content:index"
          },
          {
            "name": "会员投稿",
            "path": "/plugins/cms/contributions",
            "permission": "cms:contributions:index"
          },
          {
            "name": "表单",
            "path": "/plugins/cms/forms",
            "permission": "cms:forms:index"
          },
          {
            "name": "导航管理",
            "path": "/plugins/cms/menus",
            "permission": "cms:menus:index"
          },
          {
            "name": "模板标签",
            "path": "/plugins/cms/tags",
            "permission": "cms:tags:index"
          },
          {
            "name": "内容模型",
            "path": "/plugins/cms/models",
            "permission": "cms:models:index"
          },
          {
            "name": "站点权限",
            "path": "/plugins/cms/access",
            "permission": "cms:access:index"
          }
        ]
      }
    ],
    "routes": [
      {
        "path": "/plugins/cms/manage",
        "name": "Plugin_cms_Manage",
        "component": "Index",
        "meta": {
          "title": "CMS 内容管理"
        }
      },
      {
        "path": "/plugins/cms/sites",
        "name": "Plugin_cms_Sites",
        "component": "Sites",
        "meta": {
          "title": "站点管理",
          "permission": "cms:sites:index"
        }
      },
      {
        "path": "/plugins/cms/categories",
        "name": "Plugin_cms_Categories",
        "component": "Categories",
        "meta": {
          "title": "栏目管理",
          "permission": "cms:categories:index"
        }
      },
      {
        "path": "/plugins/cms/content",
        "name": "Plugin_cms_Content",
        "component": "Content",
        "meta": {
          "title": "内容管理",
          "permission": "cms:content:index"
        }
      },
      {
        "path": "/plugins/cms/menus",
        "name": "Plugin_cms_Menus",
        "component": "Menus",
        "meta": {
          "title": "导航管理",
          "permission": "cms:menus:index"
        }
      },
      {
        "path": "/plugins/cms/tags",
        "name": "Plugin_cms_Tags",
        "component": "Tags",
        "meta": {
          "title": "模板标签",
          "permission": "cms:tags:index"
        }
      },
      {
        "path": "/plugins/cms/models",
        "name": "Plugin_cms_Models",
        "component": "Models",
        "meta": {
          "title": "内容模型",
          "permission": "cms:models:index"
        }
      },
      {
        "path": "/plugins/cms/access",
        "name": "Plugin_cms_Access",
        "component": "Access",
        "meta": {
          "title": "站点权限",
          "permission": "cms:access:index"
        }
      },
      {
        "path": "/plugins/cms/contributions",
        "name": "Plugin_cms_Contributions",
        "component": "Contributions",
        "meta": {
          "title": "会员投稿",
          "permission": "cms:contributions:index"
        }
      },
      {
        "path": "/plugins/cms/forms",
        "name": "Plugin_cms_Forms",
        "component": "Forms",
        "meta": {
          "title": "表单",
          "permission": "cms:forms:index"
        }
      }
    ]
  },
  "serverHooks": [
    {
      "id": "sitePermissions",
      "type": "filter",
      "point": "admin.permission_codes",
      "file": "hooks/permissions.php",
      "handler": "scope",
      "priority": 100
    }
  ]
}
