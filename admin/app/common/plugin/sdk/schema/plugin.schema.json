{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funadmin.dev/schema/plugin.schema.json",
  "title": "FunAdmin Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "code", "name", "version", "requires", "entry"],
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*(?:^|/)\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "phpPath": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.php$"}]},
    "sourcePath": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.(?:vue|ts|tsx|js|jsx|css|scss|sass|less)$"}]},
    "resource": {"type": "object", "additionalProperties": false, "required": ["source", "target"], "properties": {"source": {"$ref": "#/$defs/path"}, "target": {"$ref": "#/$defs/path"}}},
    "permission": {"type": "object", "additionalProperties": false, "required": ["code", "name"], "properties": {"code": {"type": "string", "pattern": "^[a-z][a-z0-9]*:[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}, "name": {"type": "string", "minLength": 1}}},
    "menu": {"type": "object", "additionalProperties": false, "required": ["name", "path"], "properties": {"menulist": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/menu"}},"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "pattern": "^/(?:plugin|plugins)/[a-z][a-z0-9]*(/[A-Za-z0-9_-]+)*$"}, "permission": {"type": "string", "pattern": "^[a-z][a-z0-9]*:[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}}},
    "adminRoute": {"type": "object", "additionalProperties": false, "required": ["path", "name", "component"], "properties": {"path": {"type": "string", "pattern": "^/(?:plugin|plugins)/[a-z][a-z0-9]*/[A-Za-z0-9/_-]+$"}, "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, "component": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_/-]*$"}, "meta": {"type": "object", "additionalProperties": false, "properties": {"title": {"type": "string"}, "icon": {"type": "string"}, "permission": {"type": "string", "pattern": "^[a-z][a-z0-9]*:[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}}}}},
    "routeOverride": {"type": "object", "additionalProperties": false, "required": ["methods", "path", "controller", "action"], "properties": {"methods": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]}}, "path": {"type": "string", "pattern": "^/admin/[A-Za-z0-9_./-]+$"}, "controller": {"type": "string", "pattern": "^app\\\\admin\\\\plugins\\\\[a-z][a-z0-9]*\\\\controller\\\\[A-Za-z][A-Za-z0-9_]*$"}, "action": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"}, "priority": {"type": "integer", "minimum": 0}}},
    "adminWeb": {"type": "object", "additionalProperties": false, "required": ["source", "components", "minFrontendVersion", "permissions", "menu", "routes"], "properties": {"source": {"type": "string", "pattern": "^web/src/admin/plugins/[a-z][a-z0-9]*$"}, "components": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_/-]*$"}, "additionalProperties": {"$ref": "#/$defs/sourcePath"}}, "minFrontendVersion": {"type": "string", "minLength": 1}, "permissions": {"type": "array", "items": {"$ref": "#/$defs/permission"}}, "permissionGroups": {"type": "object", "maxProperties": 200, "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"}, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 100}}, "menu": {"type": "array", "items": {"$ref": "#/$defs/menu"}}, "routes": {"type": "array", "items": {"$ref": "#/$defs/adminRoute"}}}},
    "formComponent": {"type": "object", "additionalProperties": false, "required": ["type", "component", "propertySchema", "valueType", "defaultProps", "allowedEvents", "validator", "codec", "capabilityVersion"], "properties": {"type": {"type": "string", "pattern": "^[a-z][a-z0-9]*:[a-z][a-z0-9-]*$"}, "component": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_/-]*$"}, "propertySchema": {"type": "object"}, "valueType": {"type": "string", "enum": ["string", "number", "integer", "boolean", "array", "object", "mixed"]}, "defaultProps": {"type": "object"}, "allowedEvents": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"}}, "validator": {"type": "string", "pattern": "^[a-z][a-z0-9]*:[a-z][a-z0-9-]*$"}, "codec": {"type": "string", "pattern": "^[a-z][a-z0-9]*:[a-z][a-z0-9-]*$"}, "capabilityVersion": {"type": "integer", "minimum": 1}}}
  },
  "properties": {
    "externalTables": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["module", "connection", "table", "primaryKey", "columns"], "properties": {"module": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "connection": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "table": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "primaryKey": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}, "columns": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "type", "nullable"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "type": {"type": "string", "minLength": 1}, "nullable": {"type": "boolean"}}}}}}},
    "schema_version": {"const": 2},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 250},
    "description": {"type": "string"},
    "author": {"type": "string", "maxLength": 100},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"},
    "requires": {"type": "object", "additionalProperties": false, "required": ["plugins"], "properties": {"composer": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_.-]*/[a-z0-9][a-z0-9_.-]*$"}, "additionalProperties": {"type": "string", "minLength": 1}}, "php": {"type": "string", "minLength": 1}, "funadmin": {"type": "string", "minLength": 1}, "plugins": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9]*$"}, "additionalProperties": {"type": "string", "minLength": 1}}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["class", "file"], "properties": {"class": {"type": "string", "pattern": "^plugins\\\\[a-z][a-z0-9]*\\\\Plugin$"}, "file": {"const": "Plugin.php"}}},
    "adminWeb": {"$ref": "#/$defs/adminWeb"},
    "routeOverrides": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/routeOverride"}},
    "formComponents": {"type": "array", "items": {"$ref": "#/$defs/formComponent"}},
    "resources": {"type": "object", "additionalProperties": false, "properties": {"public": {"$ref": "#/$defs/resource"}}},
    "migrations": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"const": "database/migrations"}}},
    "storage": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"$ref": "#/$defs/path"}}},
    "purge": {"type": "object", "additionalProperties": false, "required": ["supported"], "properties": {"supported": {"type": "boolean"}}},
    "serverHooks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "point", "type", "file", "handler"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "point": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)*$"}, "priority": {"type": "integer"}, "type": {"enum": ["action", "filter"]}, "file": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "^hooks/.+\\.php$"}]}, "handler": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}}},
    "clientHooks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "point", "type"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}, "point": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)*$"}, "priority": {"type": "integer"}, "type": {"enum": ["action", "filter", "component"]}, "file": {"allOf": [{"$ref": "#/$defs/path"}, {"pattern": "\\.(?:ts|js)$"}]}, "export": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"}, "component": {"type": "string", "minLength": 1}, "permission": {"type": "string", "minLength": 1}, "audiences": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["public", "member", "admin"]}}}}}
  }
}
