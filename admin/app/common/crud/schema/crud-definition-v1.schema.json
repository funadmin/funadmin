{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funadmin.local/schema/crud-definition-v1.schema.json",
  "title": "FunAdmin CRUD Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "connection", "module", "entity", "table", "title", "apiPrefix", "routePath", "primaryKey", "timestamps", "softDeletes", "target", "permissionPrefix", "fields", "relations", "optionsSource", "templates", "capabilities", "features", "dataScope", "menu", "permission"],
  "allOf": [
    {
      "if": { "properties": { "target": { "properties": { "type": { "const": "core" } }, "required": ["type"] } }, "required": ["target"] },
      "then": { "required": ["generationTargets"], "properties": { "templates": { "$ref": "#/$defs/templates" } } },
      "else": { "not": { "required": ["generationTargets"] }, "properties": { "templates": { "$ref": "#/$defs/pluginTemplates" } } }
    }
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "connection": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "module": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "entity": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "table": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
    "tableIdentity": { "type": "object", "additionalProperties": false, "required": ["source", "kind"], "properties": { "source": { "enum": ["created", "adopted"] }, "kind": { "enum": ["logical", "physical"] } }, "allOf": [{ "if": { "properties": { "source": { "const": "adopted" } } }, "then": { "properties": { "kind": { "const": "physical" } } } }] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "apiPrefix": { "type": "string", "pattern": "^/[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$" },
    "routePath": { "type": "string", "pattern": "^/[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$" },
    "primaryKey": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
    "timestamps": { "type": "boolean" },
    "softDeletes": { "type": "boolean" },
    "target": { "oneOf": [{ "$ref": "#/$defs/coreTarget" }, { "$ref": "#/$defs/pluginTarget" }] },
    "permissionPrefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(:[a-z][a-z0-9-]*)+$" },
    "generationTargets": { "$ref": "#/$defs/artifacts" },
    "templates": { "type": "object" },
    "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
    "optionsSource": { "type": "array", "items": { "$ref": "#/$defs/optionsSource" } },
    "capabilities": { "type": "object", "minProperties": 1, "additionalProperties": false, "properties": {
      "list": { "type": "boolean" }, "search": { "type": "boolean" }, "form": { "type": "boolean" }, "detail": { "type": "boolean" },
      "create": { "type": "boolean" }, "update": { "type": "boolean" }, "delete": { "type": "boolean" }, "import": { "type": "boolean" }, "export": { "type": "boolean" }
    }},
    "features": { "type": "object", "additionalProperties": false,
      "required": ["batchDelete", "status", "detail", "import", "export", "upload", "dictionary", "referenceProtection", "formMode", "importLimit", "exportLimit"],
      "properties": {
        "batchDelete": { "type": "boolean" }, "status": { "type": "boolean" }, "detail": { "type": "boolean" },
        "import": { "type": "boolean" }, "export": { "type": "boolean" }, "upload": { "type": "boolean" }, "dictionary": { "type": "boolean" },
        "referenceProtection": { "type": "boolean" }, "formMode": { "enum": ["dialog", "drawer"] },
        "importLimit": { "type": "integer", "minimum": 1, "maximum": 10000 }, "exportLimit": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "formWidth": { "type": "integer", "minimum": 360, "maximum": 1600 }, "formFullscreen": { "type": "boolean" }
      }
    },
    "dataScope": { "type": "object", "required": ["enabled", "field"], "additionalProperties": false, "properties": {
      "enabled": { "type": "boolean" }, "field": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$|^$" }, "resolver": { "const": "adminDepartmentIds" }
    }},
    "menu": { "$ref": "#/$defs/menu" },
    "permission": { "$ref": "#/$defs/permission" },
    "list": {
      "type": "object",
      "properties": {
        "category": {
          "type": "object", "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "field": { "type": "string" } },
          "allOf": [{ "if": { "required": ["enabled"], "properties": { "enabled": { "const": true } } }, "then": { "required": ["field"] } }]
        },
        "tree": {
          "type": "object", "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "parentField": { "type": "string" } },
          "allOf": [{ "if": { "required": ["enabled"], "properties": { "enabled": { "const": true } } }, "then": { "required": ["parentField"] } }]
        },
        "customActions": {
          "description": "可选；缺省或空数组时不进入 canonical 文档，生成结果与哈希不变。非空时 generationTargets/templates 必须声明 customActions 与 customActionsConfig，插件目标拒绝。",
          "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/customAction" }
        }
      }
    },
    "layoutSchema": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "coreTarget": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "core" } } },
    "pluginTarget": { "type": "object", "additionalProperties": false, "required": ["type", "plugin", "scope"], "properties": { "type": { "const": "plugin" }, "plugin": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" }, "scope": { "enum": ["application", "admin", "both"] } } },
    "artifactNames": { "enum": ["migration", "model", "validate", "service", "controller", "permissionMigration", "api", "view", "form", "detail", "phpTest", "vitestTest", "langMigration", "langZh", "langEn", "memberApiController", "customActions", "customActionsConfig"] },
    "customAction": {
      "description": "设计器新建的列表自定义动作。正式生成（仅核心目标）产生 action/{Class}Actions.php 方法桩、config/actions.php 注册清单（键 business.{entity}.{key}）与权限 business:{entity}:action-{kebab(key)}。",
      "type": "object", "additionalProperties": false,
      "required": ["key", "label", "locations", "batch", "requiresConfirmation", "effect", "parameters"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,40}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 50 },
        "locations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["row", "toolbar"] } },
        "batch": { "type": "boolean", "description": "仅 toolbar 位置可为 true" },
        "requiresConfirmation": { "type": "boolean" },
        "effect": { "enum": ["write", "read"] },
        "parameters": {
          "type": "array", "maxItems": 5,
          "items": { "type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
            "type": { "enum": ["string", "integer", "number", "boolean"] }
          } }
        }
      }
    },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$" },
    "templatePath": { "type": "string", "pattern": "^(admin|frontend|database|tests)/[A-Za-z0-9._/-]+\\.tpl$" },
    "artifacts": { "type": "object", "propertyNames": { "anyOf": [{ "$ref": "#/$defs/artifactNames" }, { "pattern": "^relationModel:[A-Z][A-Za-z0-9]*$" }] }, "additionalProperties": { "$ref": "#/$defs/relativePath" }, "required": ["migration", "model", "validate", "service", "controller", "permissionMigration", "api", "view", "form", "detail", "phpTest", "vitestTest", "langMigration", "langZh", "langEn"] },
    "templates": { "type": "object", "propertyNames": { "anyOf": [{ "$ref": "#/$defs/artifactNames" }, { "const": "relationModel" }] }, "additionalProperties": { "$ref": "#/$defs/templatePath" }, "required": ["migration", "model", "validate", "service", "controller", "permissionMigration", "api", "view", "form", "detail", "phpTest", "vitestTest", "langMigration", "langZh", "langEn"] },
    "pluginTemplates": { "type": "object", "propertyNames": { "anyOf": [{ "$ref": "#/$defs/artifactNames" }, { "const": "relationModel" }] }, "additionalProperties": { "$ref": "#/$defs/templatePath" }, "required": ["migration", "model", "validate", "service", "controller", "api", "view", "form", "detail"] },
    "field": { "type": "object", "additionalProperties": false, "required": ["name", "dbType", "nullable"], "properties": {
      "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "label": { "type": "string" }, "dbType": { "type": "string", "minLength": 1 },
      "nullable": { "type": "boolean" }, "primary": { "type": "boolean" }, "comment": { "type": "string" }, "default": {}, "extra": { "type": "string" },
      "component": { "type": "string" }, "valueType": { "type": "string" }, "cast": { "type": "string" }, "managed": { "type": "boolean" }, "writable": { "type": "boolean" },
      "options": { "type": "array" }, "optionsSource": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "relation": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "references": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(?:\\\\[A-Z][A-Za-z0-9]*)*\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "inferredBy": { "type": "string" },
      "legacy": { "type": "boolean" }, "list": { "type": "boolean" }, "search": { "type": "boolean" }, "searchOperator": { "enum": ["like", "eq", "ne", "not_like", "starts_with", "ends_with", "gt", "gte", "lt", "lte", "in", "not_in", "range", "date", "is_null", "not_null"] },
      "sortable": { "type": "boolean" }, "form": { "type": "boolean" }, "detail": { "type": "boolean" }, "rules": { "type": "array", "items": { "type": "string" } },
      "listFormatter": { "enum": ["", "tag", "image", "images", "date", "datetime", "time", "money", "number", "percent", "switch", "boolean", "link", "email", "phone", "json"] }, "listWidth": { "type": "integer", "minimum": 0, "maximum": 800 }, "placeholder": { "type": "string" }, "controlProps": { "type": "object" },
      "required": { "type": "boolean" }, "minLength": { "type": "integer", "minimum": 0 }, "maxLength": { "type": "integer", "minimum": 0 }, "min": { "type": "number" }, "max": { "type": "number" },
      "enum": { "type": "array", "minItems": 1 }, "format": { "enum": ["email", "url", "date", "datetime", "uuid", "ip"] }, "unique": { "type": "boolean" },
      "dictionary": { "type": "boolean" }, "upload": { "type": "boolean" }, "indexMissing": { "type": "boolean" }, "precision": { "type": "integer", "minimum": 0 }, "scale": { "type": "integer", "minimum": 0 }
    }},
    "relation": { "type": "object", "additionalProperties": false, "required": ["name", "type", "field", "target", "targetField"], "properties": {
      "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "type": { "enum": ["belongsTo", "hasOne", "hasMany", "belongsToMany"] }, "field": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "target": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(?:\\\\[A-Z][A-Za-z0-9]*)*$" },
      "targetField": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "pivotTable": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "pivotLocalKey": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "pivotTargetKey": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "optionsSource": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "with": { "type": "boolean" },
      "targetTable": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "modelOnly": { "const": true }, "modelClass": { "type": "string", "pattern": "^app\\\\[a-z][a-z0-9_\\\\]*\\\\[A-Z][A-Za-z0-9]*$" }
    }, "allOf": [{ "if": { "required": ["targetTable"] }, "then": { "required": ["modelClass"] } }, { "if": { "properties": { "type": { "const": "belongsToMany" } }, "required": ["type"] }, "then": { "required": ["pivotTable", "pivotLocalKey", "pivotTargetKey"] } }]},
    "optionsSource": { "type": "object", "additionalProperties": false, "required": ["name", "type", "labelField", "valueField"], "properties": {
      "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "type": { "enum": ["relation", "dictionary", "endpoint"] }, "endpoint": { "type": "string" }, "dictionary": { "type": "string" }, "labelField": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }, "valueField": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" }
    }},
    "menu": { "type": "object", "additionalProperties": false, "required": ["enabled", "parentId", "parentSourceName", "name", "icon", "sortOrder", "hidden", "keepAlive", "affix", "target"], "properties": {
      "enabled": { "type": "boolean" }, "parentId": { "type": ["integer", "null"], "minimum": 1 }, "parentSourceName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$|^$" }, "name": { "type": "string", "minLength": 1 }, "icon": { "type": "string", "pattern": "^i-ep-[a-z0-9]+(?:-[a-z0-9]+)*$" }, "sortOrder": { "type": "integer", "minimum": 0, "maximum": 9999 }, "hidden": { "type": "boolean" }, "keepAlive": { "type": "boolean" }, "affix": { "type": "boolean" }, "target": { "enum": ["_self", "_blank"] }
    }},
    "permissionAction": { "type": "object", "additionalProperties": false, "required": ["action", "codeSuffix", "label"], "properties": {
      "action": { "type": "string", "pattern": "^[a-z][A-Za-z0-9-]*$" }, "codeSuffix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "label": { "type": "string", "minLength": 1 }
    }},
    "permission": { "type": "object", "additionalProperties": false, "required": ["enabled", "groupName", "actions"], "properties": {
      "enabled": { "type": "boolean" }, "groupName": { "type": "string", "minLength": 1 }, "actions": { "type": "array", "items": { "$ref": "#/$defs/permissionAction" } }
    }}
  }
}