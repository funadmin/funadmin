APP_DEBUG=false
WEBMAN_LISTEN=http://0.0.0.0:8787
WEBMAN_WORKERS=2
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=funadmin_git
DB_USERNAME=root
DB_PREFIX=fun_
# 连接现有数据库，不创建第二套业务数据库。
DB_PASSWORD=
AUTH_TOKEN_TTL=7200
MEMBER_JWT_SECRET=
MEMBER_REFRESH_JWT_SECRET=
MEMBER_ACCESS_TOKEN_TTL=7200
MEMBER_REFRESH_TOKEN_TTL=604800
MEMBER_JWT_ISSUER=funadmin.com
MEMBER_JWT_AUDIENCE=funadmin
# HTTPS 正式部署必须设置为 true；本地 HTTP 调试使用 false。
COOKIE_SECURE=false

# AI 队列与私有 sandbox；镜像必须使用固定 digest，不默认挂载 Docker socket。
AI_QUEUE_ENABLED=false
AI_QUEUE_WORKERS=1
AI_QUEUE_REDIS_URL=redis://127.0.0.1:6379
AI_QUEUE_REDIS_PASSWORD=
AI_QUEUE_REDIS_DATABASE=0
AI_QUEUE_REDIS_PREFIX=funadmin-ai:
AI_SANDBOX_IMAGE=
AI_PROVIDER=
AI_PROTOCOL=openai-chat
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TOOLS_ALLOWLIST=
# AI 会话 SSE 票据密钥，正式部署请设置至少 32 字节的随机值；留空则由本机配置派生。
AI_STREAM_TICKET_SECRET=

FUNADMIN_VERSION=1.0.0
PLUGIN_MARKETPLACE_URL=
PLUGIN_MARKETPLACE_PUBLIC_KEY=
# 插件前端源码项目根目录；留空时使用与 admin 同级的 web。
PLUGIN_ADMIN_WEB_PATH=
IDENTITY_ISSUER=
OAUTH_SUBJECT_PEPPER=
MARKET_PUBLIC_URL=
MARKET_SIGNING_SECRET_KEY=
