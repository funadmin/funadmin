APP_DEBUG=false
WEBMAN_LISTEN=http://0.0.0.0:8787
WEBMAN_WORKERS=2
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=funadmin_git
DB_USERNAME=root
DB_PREFIX=fun_
# 连接现有数据库，不创建第二套业务数据库。
DB_PASSWORD=
AUTH_TOKEN_TTL=7200
# 授权 worker 缓存兜底 TTL（秒）；<=0 关闭 worker 缓存
AUTH_AUTHZ_CACHE_TTL=60
MEMBER_JWT_SECRET=
MEMBER_REFRESH_JWT_SECRET=
MEMBER_ACCESS_TOKEN_TTL=7200
MEMBER_REFRESH_TOKEN_TTL=604800
MEMBER_JWT_ISSUER=funadmin.com
MEMBER_JWT_AUDIENCE=funadmin
# HTTPS 正式部署必须设置为 true；本地 HTTP 调试使用 false。
COOKIE_SECURE=false
# 允许跨域调用会员/开放 API（/api/*，Bearer 令牌）的前端来源，逗号分隔的精确 origin（如 https://www.example.com,https://m.example.com）。
# 留空则不允许任何跨域来源；不支持通配符；从不允许携带 Cookie。后台 /admin 不支持跨域，须与前端同源部署。
CORS_ALLOWED_ORIGINS=
# 跨域生效的路径前缀（逗号分隔，默认 /api/）；会员前端跨域部署可加 /qa/api/,/cms/member/。/admin 始终不开放跨域。
CORS_PATHS=/api/

# AI 队列与私有 sandbox；镜像必须使用固定 digest，不默认挂载 Docker socket。
AI_QUEUE_ENABLED=false
AI_QUEUE_WORKERS=1
AI_QUEUE_REDIS_URL=redis://127.0.0.1:6379
AI_QUEUE_REDIS_PASSWORD=
AI_QUEUE_REDIS_DATABASE=0
AI_QUEUE_REDIS_PREFIX=funadmin-ai:
AI_SANDBOX_IMAGE=
AI_PROVIDER=
AI_PROTOCOL=openai-chat
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TOOLS_ALLOWLIST=
# AI 会话 SSE 票据密钥，正式部署请设置至少 32 字节的随机值；留空则由本机配置派生。
AI_STREAM_TICKET_SECRET=

FUNADMIN_VERSION=1.0.0
# 留空时跳过云端更新检查，本地插件可正常安装。使用云市场时填写完整根地址（包含协议和域名，不含 /api/v3）。
PLUGIN_MARKETPLACE_URL=
PLUGIN_MARKETPLACE_PUBLIC_KEY=
# 插件前端源码项目根目录；留空时使用与 admin 同级的 web。
PLUGIN_ADMIN_WEB_PATH=
IDENTITY_ISSUER=
OAUTH_SUBJECT_PEPPER=
