APP_DEBUG = true

DB_DRIVER = mysql
DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = funadmin
DB_USER = funadmin
DB_PASS = funadmin
DB_PORT = 3306
DB_CHARSET = utf8mb4
DB_PREFIX = fun_

DEFAULT_LANG = zh-cn

# API JWT 密钥必须使用至少 32 个字符的随机字符串，且两者不能相同
API_JWT_SECRET =
API_REFRESH_JWT_SECRET =
API_ACCESS_TOKEN_TTL = 7200
API_REFRESH_TOKEN_TTL = 2592000
API_JWT_ISSUER = funadmin.com
API_JWT_AUDIENCE = funadmin

# 企业身份发行者由部署配置固定，禁止根据请求 Host 或代理头动态生成
# 通过 .env 文件配置时使用下列名称；进程环境变量需添加 PHP_ 前缀
IDENTITY_ISSUER =
IDENTITY_TRUSTED_HOSTS =
IDENTITY_TRUSTED_PROXIES =
# OAuth 密钥仅配置文件路径或部署注入值，禁止提交私钥和加密密钥
OAUTH_PRIVATE_KEY_PATH =
OAUTH_ENCRYPTION_KEY =

# 插件市场 Ed25519 原始公钥：仅填写 32 字节公钥的标准 Base64，不要填写 PEM 或换行
PLUGIN_MARKETPLACE_PUBLIC_KEY =