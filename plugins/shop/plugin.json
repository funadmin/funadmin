{
    "schema_version": 2,
    "code": "shop",
    "name": "商城插件",
    "description": "",
    "author": "",
    "version": "1.0.0",
    "requires": {
        "php": ">=8.1",
        "funadmin": ">=1.0.0",
        "plugins": {}
    },
    "entry": {
        "class": "plugins\\shop\\Plugin",
        "file": "Plugin.php"
    },
    "resources": {
        "public": {
            "source": "resources/public",
            "target": "plugin-assets/shop/public"
        }
    },
    "migrations": {
        "path": "database/migrations"
    },
    "storage": {
        "path": "storage"
    },
    "purge": {
        "supported": false
    },
    "adminWeb": {
        "source": "admin-web",
        "components": {
            "Index": "Index.vue"
        },
        "minFrontendVersion": "1.0.0",
        "permissions": [],
        "menu": [],
        "routes": []
    }
}
