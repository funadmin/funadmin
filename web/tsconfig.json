{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "useDefineForClassFields": true,
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client", "element-plus/global"],
    "paths": {
      "@/*": ["src/*"],
      "@/api": ["src/admin/api/index.ts"],
      "@/api/*": ["src/admin/api/*"],
      "@/layout": ["src/admin/layout/index.vue"],
      "@/layout/*": ["src/admin/layout/*"],
      "@/mock": ["src/admin/mock/index.ts"],
      "@/mock/*": ["src/admin/mock/*"],
      "@/plugins": ["src/admin/plugins/index.ts"],
      "@/plugins/*": ["src/admin/plugins/*"],
      "@/router": ["src/admin/router/index.ts"],
      "@/router/*": ["src/admin/router/*"],
      "@/store": ["src/admin/store/index.ts"],
      "@/store/*": ["src/admin/store/*"],
      "@/views": ["src/admin/views/index.vue"],
      "@/views/*": ["src/admin/views/*"],
      "@/components": ["src/shared/components/index.ts"],
      "@/components/*": ["src/shared/components/*"],
      "@/composables/*": ["src/shared/composables/*"],
      "@/config": ["src/shared/config/index.ts"],
      "@/config/*": ["src/shared/config/*"],
      "@/directives": ["src/shared/directives/index.ts"],
      "@/directives/*": ["src/shared/directives/*"],
      "@/locales": ["src/shared/locales/index.ts"],
      "@/locales/*": ["src/shared/locales/*"],
      "@/styles/*": ["src/shared/styles/*"],
      "@/types/*": ["src/shared/types/*"],
      "@/utils/*": ["src/shared/utils/*"],
      "#/*": ["src/shared/types/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "vite.config.ts",
    "auto-imports.d.ts",
    "components.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
