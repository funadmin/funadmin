{
  "module": "system",
  "name": "demo",
  "apiPrefix": "/system/demo",
  "title": "示例 CRUD",
  "subtitle": "由 gen:crud 生成，可按字段改配置后重新生成或手改",
  "permPrefix": "system:demo",
  "deleteMode": "queryIds",
  "columns": [
    { "prop": "id", "label": "ID", "width": 80, "align": "center" },
    { "prop": "name", "label": "名称", "minWidth": 140 },
    {
      "prop": "status",
      "label": "状态",
      "width": 100,
      "align": "center",
      "tag": true,
      "tagMap": {
        "1": { "type": "success", "text": "启用" },
        "0": { "type": "info", "text": "禁用" }
      }
    },
    { "prop": "remark", "label": "备注", "minWidth": 160, "ellipsis": true },
    { "prop": "createdAt", "label": "创建时间", "width": 170 }
  ],
  "search": [
    {
      "prop": "keyword",
      "label": "关键词",
      "type": "input",
      "placeholder": "名称 / 备注"
    },
    {
      "prop": "status",
      "label": "状态",
      "type": "select",
      "placeholder": "全部",
      "options": [
        { "label": "启用", "value": 1 },
        { "label": "禁用", "value": 0 }
      ]
    }
  ],
  "formFields": [
    { "prop": "name", "label": "名称", "required": true, "span": 12, "placeholder": "请输入" },
    {
      "prop": "status",
      "label": "状态",
      "type": "radio01",
      "span": 12
    },
    {
      "prop": "remark",
      "label": "备注",
      "type": "textarea",
      "span": 24,
      "rows": 3
    }
  ]
}
